{
  "productName": "codex-portable",
  "version": "0.1.0",
  "identifier": "com.codex.portable.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "Main",
        "title": "Codex Port\u00e1til",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "centered": true
      }
    ],
    "security": {
      "csp": "\\'default-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none''"
    },
    "bundle": {
      "active": true,
      "targets": [
        {
          "target": "all"
        }
      ]
    }
  }
}